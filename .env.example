# -----------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit .env or real values.
# In Google Cloud, these values come from Secret Manager, not from files.
# -----------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# Local default is SQLite (async driver). For docker-compose PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/youtube_agent
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Directory containing languages.yaml and publishing-policy.yaml
CONFIG_DIR=./config

# --- Google OAuth 2.0 (Web application client) -------------------------------
# Either set ID/secret directly, or point to the downloaded client JSON stored
# OUTSIDE the repository (recommended), e.g. ~/.config/youtube-multilingual-agent/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Gemini (fallback subtitle translation + metadata localization) ----------
# Local dev: API key. Production: prefer Vertex AI with the service account
# (GEMINI_USE_VERTEX=true) so no API key needs to be stored at all.
GEMINI_API_KEY=
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1

# --- YouTube ------------------------------------------------------------------
# The single channel this deployment is authorized to manage.
YOUTUBE_CHANNEL_ID=
# Hard kill switch for ANY write to YouTube. Keep false until Stage 7 sign-off.
YOUTUBE_PUBLISHING_ENABLED=false

# --- Security -----------------------------------------------------------------
# Fernet key used to encrypt OAuth refresh tokens at rest (local/dev only).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret for WebSub (PubSubHubbub) HMAC signatures on upload notifications.
WEBSUB_SECRET=
# Comma-separated Google account emails allowed to use the dashboard.
DASHBOARD_ALLOWED_EMAILS=
